# ==========================================
# AI Concierge Portal - 環境変数設定
# ==========================================

# GEMINI_API_KEY: Google Gemini APIキー (必須)
# AI Studioではシークレットパネルから自動注入されます。
# ローカル開発では Google AI Studio (https://aistudio.google.com/) から発行したAPIキーを設定してください。
GEMINI_API_KEY="AIzaSy..."

# PORT: サーバーリッスンポート (デフォルト: 3000)
PORT=3000

# NODE_ENV: 実行環境 ('development' または 'production')
NODE_ENV="development"

# APP_URL: アプリケーションのホストURL (AI Studioにて自動注入)
APP_URL="http://localhost:3000"
